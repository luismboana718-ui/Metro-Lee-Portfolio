<!DOCTYPE html>
<html lang="pt-BR" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metro Lee (the_seven-lee) | Produtor & Beatmaker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0a0a0c',
                        cardBg: '#121217',
                        accentOrange: '#f97316',
                        accentGold: '#eab308',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            background-color: #0a0a0c;
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
        }
        .glass-panel {
            background: rgba(18, 18, 23, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glow-orange {
            box-shadow: 0 0 25px rgba(249, 115, 22, 0.35);
        }
        .glow-gold {
            box-shadow: 0 0 25px rgba(234, 179, 8, 0.3);
        }
        .text-gradient {
            background: linear-gradient(135deg, #f97316 0%, #eab308 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.05); }
        }
        .animate-pulse-glow {
            animation: pulseGlow 4s infinite ease-in-out;
        }
        /* Custom Audio Player Range Styling */
        input[type=range] {
            accent-color: #f97316;
        }
    </style>
</head>
<body class="bg-darkBg text-gray-100 antialiased overflow-x-hidden selection:bg-orange-500 selection:text-white">

    <!-- Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-white/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-orange-600 to-amber-500 flex items-center justify-center glow-orange group-hover:scale-105 transition-transform">
                    <i class="fa-solid fa-wave-square text-white text-lg"></i>
                </div>
                <div>
                    <span class="text-xl font-black tracking-wider text-white">METRO LEE</span>
                    <span class="block text-xs font-medium text-orange-500 tracking-widest">THE_SEVEN-LEE</span>
                </div>
            </a>
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-gray-300">
                <a href="#sobre" class="hover:text-orange-500 transition-colors">Sobre</a>
                <a href="#servicos" class="hover:text-orange-500 transition-colors">Serviços</a>
                <a href="#player" class="hover:text-orange-500 transition-colors">Beats Demo</a>
                <a href="#escutar" class="hover:text-orange-500 transition-colors">Escutar & Mídia</a>
                <a href="#contato" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 text-white font-semibold glow-orange hover:opacity-90 transition-opacity">Orçamento</a>
            </nav>
            <!-- Mobile Menu Button -->
            <button id="menu-btn" class="md:hidden text-gray-300 hover:text-white focus:outline-none text-2xl">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden glass-panel border-t border-white/10 px-4 pt-4 pb-6 space-y-3">
            <a href="#sobre" class="block text-gray-300 hover:text-orange-500 py-2">Sobre</a>
            <a href="#servicos" class="block text-gray-300 hover:text-orange-500 py-2">Serviços</a>
            <a href="#player" class="block text-gray-300 hover:text-orange-500 py-2">Beats Demo</a>
            <a href="#escutar" class="block text-gray-300 hover:text-orange-500 py-2">Escutar & Mídia</a>
            <a href="#contato" class="block text-center px-5 py-3 rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 text-white font-semibold">Orçamento</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-center pt-28 pb-20 px-4 sm:px-6 lg:px-8">
        <!-- Background decorative ambient circles -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-orange-600/20 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-5xl mx-auto text-center relative z-10 space-y-8">
            <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-full glass-panel border border-orange-500/30 text-orange-400 text-xs sm:text-sm font-semibold tracking-wide uppercase">
                <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
                <span>Disponível para Projetos & Beats Exclusivos</span>
            </div>
            
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white">
                METRO LEE <span class="block text-gradient mt-2">the_seven-lee</span>
            </h1>

            <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto font-light leading-relaxed">
                Produtor Musical, Beatmaker de alto padrão e Engenheiro de Mixagem focado em elevar o seu som ao nível profissional mundial.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                <a href="#escutar" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 text-white font-bold text-base glow-orange hover:scale-105 transition-transform flex items-center justify-center space-x-3">
                    <i class="fa-solid fa-headphones text-lg"></i>
                    <span>Escutar Músicas & Redes</span>
                </a>
                <a href="#contato" class="w-full sm:w-auto px-8 py-4 rounded-xl glass-panel text-white font-semibold text-base hover:bg-white/10 transition-colors flex items-center justify-center space-x-3 border border-white/10">
                    <i class="fa-solid fa-paper-plane text-orange-500"></i>
                    <span>Falar no WhatsApp / Contato</span>
                </a>
            </div>

            <!-- Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-6 pt-12 max-w-3xl mx-auto">
                <div class="glass-panel p-6 rounded-2xl border border-white/5">
                    <span class="block text-3xl sm:text-4xl font-extrabold text-white">100+</span>
                    <span class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-1 block">Beats Produzidos</span>
                </div>
                <div class="glass-panel p-6 rounded-2xl border border-white/5">
                    <span class="block text-3xl sm:text-4xl font-extrabold text-orange-500">Pro</span>
                    <span class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-1 block">Mix & Master</span>
                </div>
                <div class="glass-panel p-6 rounded-2xl border border-white/5 col-span-2 md:col-span-1">
                    <span class="block text-3xl sm:text-4xl font-extrabold text-amber-400">Viral</span>
                    <span class="text-xs sm:text-sm text-gray-400 uppercase tracking-wider mt-1 block">Conteúdo nas Redes</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Sobre Mim Section -->
    <section id="sobre" class="py-24 px-4 sm:px-6 lg:px-8 relative bg-gradient-to-b from-transparent via-[#0d0d12] to-transparent">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <div class="lg:col-span-5 relative">
                    <div class="relative rounded-3xl overflow-hidden glass-panel p-3 border border-white/10 glow-orange">
                        <img src="https://placehold.co/600x700/121217/f97316?text=Metro+Lee" alt="Metro Lee the_seven-lee" class="w-full h-[400px] sm:h-[480px] object-cover rounded-2xl filter grayscale hover:grayscale-0 transition-all duration-500">
                        <div class="absolute bottom-6 left-6 right-6 p-4 glass-panel rounded-xl backdrop-blur-md">
                            <span class="text-orange-400 font-bold text-sm block">@the_seven-lee</span>
                            <span class="text-white text-xs text-gray-300">Criando identidade sonora única para artistas.</span>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-7 space-y-6">
                    <div class="inline-flex items-center space-x-2 text-orange-500 font-bold uppercase tracking-wider text-xs">
                        <i class="fa-solid fa-sliders"></i>
                        <span>Quem é o Artista</span>
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-black text-white">
                        Paixão pela sonoridade perfeita, do beat à masterização final.
                    </h2>
                    <p class="text-gray-300 leading-relaxed font-light">
                        Prazer, sou <strong class="text-white font-semibold">Metro Lee</strong> (conhecido nas redes como <span class="text-orange-400 font-medium">the_seven-lee</span>). Minha jornada na música é guiada pela busca incessante por batidas marcantes, límpidas e com graves pesados que conectam o artista diretamente com o ouvinte.
                    </p>
                    <p class="text-gray-400 leading-relaxed font-light">
                        Como produtor, beatmaker e engenheiro de mixagem, trabalho lado a lado com talentos para transformar ideias brutas em faixas prontas para as plataformas digitais, rádio e pistas de dança com nível de excelência internacional.
                    </p>
                    
                    <div class="grid grid-cols-2 gap-4 pt-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-500 flex items-center justify-center font-bold">✓</div>
                            <span class="text-sm font-medium text-gray-200">Beatmaking Exclusivo</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-500 flex items-center justify-center font-bold">✓</div>
                            <span class="text-sm font-medium text-gray-200">Mixagem Profissional</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-500 flex items-center justify-center font-bold">✓</div>
                            <span class="text-sm font-medium text-gray-200">Masterização Pronta</span>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-lg bg-orange-500/20 text-orange-500 flex items-center justify-center font-bold">✓</div>
                            <span class="text-sm font-medium text-gray-200">Consultoria Artística</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Serviços Section -->
    <section id="servicos" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
            <span class="text-orange-500 font-bold uppercase tracking-widest text-xs">O que eu faço</span>
            <h2 class="text-3xl sm:text-4xl font-black text-white">Serviços Profissionais</h2>
            <p class="text-gray-400 font-light">Soluções completas para elevar a qualidade e o impacto comercial das suas músicas.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 hover:border-orange-500/50 transition-all duration-300 group hover:-translate-y-2">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-600 to-amber-500 flex items-center justify-center text-white text-2xl mb-6 glow-orange group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-compact-disc"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Produção Musical</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">
                    Desenvolvimento integral da sua música, desde o arranjo inicial, escolha de timbres, direção vocal até o arranjo final.
                </p>
                <ul class="space-y-2 text-xs text-gray-300 font-medium">
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-orange-500"></i> <span>Arranjos modernos</span></li>
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-orange-500"></i> <span>Direção criativa</span></li>
                </ul>
            </div>

            <!-- Card 2 -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 hover:border-orange-500/50 transition-all duration-300 group hover:-translate-y-2">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-yellow-500 flex items-center justify-center text-white text-2xl mb-6 glow-gold group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-drum"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Criação de Beats</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">
                    Instrumentais exclusivos e personalizados (Trap, Hip-Hop, Afrobeats, R&B) com graves marcantes e mixagem pronta.
                </p>
                <ul class="space-y-2 text-xs text-gray-300 font-medium">
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-amber-400"></i> <span>Stems separados</span></li>
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-amber-400"></i> <span>Direitos comerciais</span></li>
                </ul>
            </div>

            <!-- Card 3 -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 hover:border-orange-500/50 transition-all duration-300 group hover:-translate-y-2">
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-600 to-red-600 flex items-center justify-center text-white text-2xl mb-6 glow-orange group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Mixagem & Masterização</h3>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">
                    Engenharia de som de nível superior. Correção tonal, dinâmica perfeita e volume comercial para rivalizar com hits globais.
                </p>
                <ul class="space-y-2 text-xs text-gray-300 font-medium">
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-orange-500"></i> <span>Padrão Spotify/Apple Music</span></li>
                    <li class="flex items-center space-x-2"><i class="fa-solid fa-check text-orange-500"></i> <span>Clareza e punch máximo</span></li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Player de Demonstração Section -->
    <section id="player" class="py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
        <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-orange-500/30 glow-orange relative overflow-hidden">
            <div class="absolute top-0 right-0 p-8 text-orange-500/10 text-8xl font-black pointer-events-none">
                <i class="fa-solid fa-music"></i>
            </div>
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8">
                <div>
                    <span class="text-orange-400 text-xs font-bold uppercase tracking-wider block mb-1">Demonstração de Beats</span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white" id="current-track-title">Neon Nights (Trap Beat)</h2>
                    <p class="text-gray-400 text-sm">Prod. Metro Lee (the_seven-lee)</p>
                </div>
                <div class="flex items-center space-x-2 bg-black/40 p-2 rounded-xl border border-white/10">
                    <button onclick="changeTrack(0)" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-orange-600 text-white track-btn" data-index="0">Beat 1</button>
                    <button onclick="changeTrack(1)" class="px-3 py-1.5 rounded-lg text-xs font-medium text-gray-400 hover:text-white track-btn" data-index="1">Beat 2</button>
                    <button onclick="changeTrack(2)" class="px-3 py-1.5 rounded-lg text-xs font-medium text-gray-400 hover:text-white track-btn" data-index="2">Beat 3</button>
                </div>
            </div>

            <!-- Waveform Simulation / Visualizer bars -->
            <div class="flex items-center justify-center space-x-1.5 h-16 bg-black/50 rounded-2xl p-4 mb-6 border border-white/5" id="visualizer">
                <div class="w-1.5 bg-orange-500 rounded-full h-4 animate-pulse"></div>
                <div class="w-1.5 bg-orange-500 rounded-full h-8 animate-pulse" style="animation-delay: 0.1s"></div>
                <div class="w-1.5 bg-amber-500 rounded-full h-12 animate-pulse" style="animation-delay: 0.2s"></div>
                <div class="w-1.5 bg-amber-500 rounded-full h-6 animate-pulse" style="animation-delay: 0.3s"></div>
                <div class="w-1.5 bg-orange-500 rounded-full h-10 animate-pulse" style="animation-delay: 0.4s"></div>
                <div class="w-1.5 bg-orange-500 rounded-full h-14 animate-pulse" style="animation-delay: 0.5s"></div>
                <div class="w-1.5 bg-amber-500 rounded-full h-8 animate-pulse" style="animation-delay: 0.6s"></div>
                <div class="w-1.5 bg-amber-500 rounded-full h-12 animate-pulse" style="animation-delay: 0.2s"></div>
                <div class="w-1.5 bg-orange-500 rounded-full h-10 animate-pulse" style="animation-delay: 0.3s"></div>
                <div class="w-1.5 bg-orange-500 rounded-full h-5 animate-pulse" style="animation-delay: 0.1s"></div>
            </div>

            <!-- Player Controls -->
            <div class="space-y-4">
                <div class="flex items-center justify-between text-xs text-gray-400 font-medium">
                    <span id="current-time">0:00</span>
                    <span id="total-duration">2:45</span>
                </div>
                <!-- Progress bar input -->
                <input type="range" id="progress-bar" value="0" max="100" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer">

                <div class="flex items-center justify-center space-x-6 pt-2">
                    <button onclick="prevTrack()" class="w-10 h-10 rounded-full glass-panel flex items-center justify-center text-gray-300 hover:text-white hover:bg-white/10 transition-all">
                        <i class="fa-solid fa-backward-step"></i>
                    </button>
                    <button id="play-pause-btn" onclick="togglePlay()" class="w-14 h-14 rounded-full bg-gradient-to-r from-orange-600 to-amber-500 flex items-center justify-center text-white text-xl glow-orange hover:scale-105 transition-transform">
                        <i class="fa-solid fa-play" id="play-icon"></i>
                    </button>
                    <button onclick="nextTrack()" class="w-10 h-10 rounded-full glass-panel flex items-center justify-center text-gray-300 hover:text-white hover:bg-white/10 transition-all">
                        <i class="fa-solid fa-forward-step"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Escutar Músicas / Redes Sociais & Conteúdo Section -->
    <section id="escutar" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
            <span class="text-orange-500 font-bold uppercase tracking-widest text-xs">Conecte-se & Escute</span>
            <h2 class="text-3xl sm:text-4xl font-black text-white">Escutar Músicas & Redes Sociais</h2>
            <p class="text-gray-400 font-light">Acompanhe os lançamentos de beats, tutoriais de mixagem e conteúdos exclusivos nas principais plataformas.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- YouTube Card -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 flex flex-col justify-between hover:border-red-500/50 transition-all duration-300 group">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-red-600/20 text-red-500 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-brands fa-youtube"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">YouTube Oficial</h3>
                    <p class="text-gray-400 text-sm mb-6">Assista a beats completos em alta definição, making of de produções e vlogs de estúdio.</p>
                </div>
                <a href="https://www.youtube.com/@the_seven-lee" target="_blank" class="w-full py-3.5 px-4 rounded-xl bg-red-600 text-white font-semibold text-center hover:bg-red-700 transition-colors flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-play"></i>
                    <span>Acessar YouTube</span>
                </a>
            </div>

            <!-- TikTok Card -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 flex flex-col justify-between hover:border-white/40 transition-all duration-300 group">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-white/10 text-white flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-brands fa-tiktok"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">TikTok Musical</h3>
                    <p class="text-gray-400 text-sm mb-6">Dicas rápidas de beatmaking, antes e depois de mixagem e trechos virais de novos beats.</p>
                </div>
                <a href="http://www.tiktok.com/@the_sevenlee.metrolee" target="_blank" class="w-full py-3.5 px-4 rounded-xl bg-gray-800 text-white font-semibold text-center hover:bg-gray-700 transition-colors flex items-center justify-center space-x-2 border border-white/10">
                    <i class="fa-solid fa-video"></i>
                    <span>Acessar TikTok</span>
                </a>
            </div>

            <!-- Facebook Card -->
            <div class="glass-panel p-8 rounded-3xl border border-white/10 flex flex-col justify-between hover:border-blue-500/50 transition-all duration-300 group">
                <div>
                    <div class="w-14 h-14 rounded-2xl bg-blue-600/20 text-blue-500 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        <i class="fa-brands fa-facebook-f"></i>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Comunidade Facebook</h3>
                    <p class="text-gray-400 text-sm mb-6">Conecte-se diretamente, acompanhe postagens sobre o estúdio e novidades da carreira.</p>
                </div>
                <a href="https://www.facebook.com/share/1Es6dpmNEx/?mibextid=wwXIfr" target="_blank" class="w-full py-3.5 px-4 rounded-xl bg-blue-600 text-white font-semibold text-center hover:bg-blue-700 transition-colors flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-users"></i>
                    <span>Acessar Facebook</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Contato / Orçamentos Section -->
    <section id="contato" class="py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
        <div class="glass-panel p-8 sm:p-12 rounded-3xl border border-white/10 relative">
            <div class="text-center max-w-2xl mx-auto space-y-4 mb-12">
                <span class="text-orange-500 font-bold uppercase tracking-widest text-xs">Vamos trabalhar juntos</span>
                <h2 class="text-3xl sm:text-4xl font-black text-white">Solicitar Orçamento / Encomendar Beat</h2>
                <p class="text-gray-400 font-light">Preencha o formulário abaixo para enviar a sua solicitação direto para o WhatsApp do Metro Lee.</p>
            </div>

            <form onsubmit="handleFormSubmit(event)" class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">Seu Nome / Artista</label>
                        <input type="text" id="client-name" required placeholder="Ex: MC João" class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white focus:outline-none focus:border-orange-500 transition-colors text-sm">
                    </div>
                    <div class="space-y-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">WhatsApp / Telefone</label>
                        <input type="tel" id="client-phone" required placeholder="+258 84 000 0000" class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white focus:outline-none focus:border-orange-500 transition-colors text-sm">
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">Tipo de Serviço Desejado</label>
                    <select id="client-service" class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white focus:outline-none focus:border-orange-500 transition-colors text-sm">
                        <option class="bg-gray-900">Beat Exclusivo / Personalizado</option>
                        <option class="bg-gray-900">Mixagem e Masterização</option>
                        <option class="bg-gray-900">Produção Musical Completa</option>
                        <option class="bg-gray-900">Outros Projetos / Parcerias</option>
                    </select>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-gray-300">Detalhes do Projeto & Ideias</label>
                    <textarea id="client-details" rows="4" placeholder="Conte mais sobre o estilo musical, referências ou o que você precisa..." class="w-full px-4 py-3.5 rounded-xl bg-black/50 border border-white/10 text-white focus:outline-none focus:border-orange-500 transition-colors text-sm h-32 resize-none block"></textarea>
                </div>

                <button type="submit" class="w-full py-4 rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 text-white font-bold text-base glow-orange hover:opacity-95 transition-opacity flex items-center justify-center space-x-3 cursor-pointer">
                    <i class="fa-brands fa-whatsapp text-xl"></i>
                    <span>Enviar Orçamento para o WhatsApp (+258 87 344 7177)</span>
                </button>
            </form>

            <!-- Success message modal box -->
            <div id="success-msg" class="hidden mt-6 p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-center text-sm">
                Redirecionando para o WhatsApp do Metro Lee (+258 87 344 7177)...
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-12 px-4 sm:px-6 lg:px-8 bg-black/40">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded-lg bg-orange-600 flex items-center justify-center text-white font-bold">
                    <i class="fa-solid fa-wave-square text-sm"></i>
                </div>
                <span class="font-bold tracking-wider text-white">METRO LEE (THE_SEVEN-LEE)</span>
            </div>
            <div class="flex items-center space-x-6 text-gray-400 text-lg">
                <a href="https://www.youtube.com/@the_seven-lee" target="_blank" class="hover:text-orange-500 transition-colors"><i class="fa-brands fa-youtube"></i></a>
                <a href="http://www.tiktok.com/@the_sevenlee.metrolee" target="_blank" class="hover:text-orange-500 transition-colors"><i class="fa-brands fa-tiktok"></i></a>
                <a href="https://www.facebook.com/share/1Es6dpmNEx/?mibextid=wwXIfr" target="_blank" class="hover:text-orange-500 transition-colors"><i class="fa-brands fa-facebook-f"></i></a>
            </div>
            <p class="text-xs text-gray-500">
                &copy; 2026 Metro Lee. Todos os direitos reservados.
            </p>
        </div>
    </footer>

    <!-- JavaScript for Mobile Menu, Audio Player Simulation & Form -->
    <script>
        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Audio Player Simulation
        const tracks = [
            { title: "Neon Nights (Trap Beat)", duration: "2:45" },
            { title: "Afro Soul Vibe (Afrobeats)", duration: "3:10" },
            { title: "Heavy 808s (Hip-Hop Instrumental)", duration: "2:30" }
        ];

        let currentTrackIndex = 0;
        let isPlaying = false;
        let progressInterval = null;
        let currentProgress = 0;

        const playPauseBtn = document.getElementById('play-icon');
        const trackTitleEl = document.getElementById('current-track-title');
        const durationEl = document.getElementById('total-duration');
        const currentTimeEl = document.getElementById('current-time');
        const progressBar = document.getElementById('progress-bar');
        const trackBtns = document.querySelectorAll('.track-btn');

        function updateTrackInfo() {
            trackTitleEl.textContent = tracks[currentTrackIndex].title;
            durationEl.textContent = tracks[currentTrackIndex].duration;
            trackBtns.forEach((btn, idx) => {
                if (idx === currentTrackIndex) {
                    btn.className = "px-3 py-1.5 rounded-lg text-xs font-medium bg-orange-600 text-white track-btn";
                } else {
                    btn.className = "px-3 py-1.5 rounded-lg text-xs font-medium text-gray-400 hover:text-white track-btn";
                }
            });
        }

        function togglePlay() {
            isPlaying = !isPlaying;
            if (isPlaying) {
                playPauseBtn.className = "fa-solid fa-pause";
                startProgress();
            } else {
                playPauseBtn.className = "fa-solid fa-play";
                stopProgress();
            }
        }

        function startProgress() {
            if (progressInterval) clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                currentProgress += 0.8;
                if (currentProgress > 100) {
                    currentProgress = 0;
                    nextTrack();
                    return;
                }
                progressBar.value = currentProgress;
                updateCurrentTimeDisplay();
            }, 300);
        }

        function stopProgress() {
            if (progressInterval) clearInterval(progressInterval);
        }

        function updateCurrentTimeDisplay() {
            const totalSeconds = currentTrackIndex === 0 ? 165 : currentTrackIndex === 1 ? 190 : 150;
            const elapsed = Math.floor((currentProgress / 100) * totalSeconds);
            const mins = Math.floor(elapsed / 60);
            const secs = elapsed % 60;
            currentTimeEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }

        function changeTrack(index) {
            currentTrackIndex = index;
            currentProgress = 0;
            progressBar.value = 0;
            updateTrackInfo();
            if (!isPlaying) {
                togglePlay();
            } else {
                startProgress();
            }
        }

        function nextTrack() {
            currentTrackIndex = (currentTrackIndex + 1) % tracks.length;
            currentProgress = 0;
            progressBar.value = 0;
            updateTrackInfo();
            if (isPlaying) startProgress();
        }

        function prevTrack() {
            currentTrackIndex = (currentTrackIndex - 1 + tracks.length) % tracks.length;
            currentProgress = 0;
            progressBar.value = 0;
            updateTrackInfo();
            if (isPlaying) startProgress();
        }

        // WhatsApp Form Submit Handler (+258 87 344 7177)
        function handleFormSubmit(event) {
            event.preventDefault();
            
            const name = document.getElementById('client-name').value.trim();
            const phone = document.getElementById('client-phone').value.trim();
            const service = document.getElementById('client-service').value;
            const details = document.getElementById('client-details').value.trim();

            // Format message for WhatsApp
            const message = `*Novo Orçamento / Contato - Site*\n\n` +
                            `👤 *Nome/Artista:* ${name}\n` +
                            `📱 *WhatsApp do Cliente:* ${phone}\n` +
                            `🎛️ *Serviço:* ${service}\n` +
                            `💬 *Detalhes:* ${details || 'Nenhum detalhe adicional.'}`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappNumber = "258873447177";
            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

            const successMsg = document.getElementById('success-msg');
            successMsg.classList.remove('hidden');

            setTimeout(() => {
                successMsg.classList.add('hidden');
                window.open(whatsappUrl, '_blank');
                event.target.reset();
            }, 1500);
        }
    </script>
</body>
</html>
